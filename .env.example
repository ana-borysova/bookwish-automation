# Template. Copy to .env and fill in the values.
# The .env file itself never reaches git — see .gitignore.

# Connection string for the Supabase database.
#
# Where to get it: Supabase dashboard -> Settings -> Database -> Connection string.
# Several options are offered there. Use the SESSION POOLER (or Direct connection).
# The TRANSACTION POOLER (port 6543) will NOT work: it does not hold a session the
# way pg_dump requires.
#
# Format: postgresql://USER:PASSWORD@HOST:5432/postgres
SUPABASE_DB_URL=
