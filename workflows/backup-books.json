{
  "name": "Backup books",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 21
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        0
      ],
      "id": "8759fb83-4b04-405c-bf19-6b00bf76022b",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "command": "set -e\nTS=$(date +%Y-%m-%d-%H%M)\nTMP=\"/backups/.books-$TS.tmp\"\nOUT=\"/backups/books-$TS.sql\"\npg_dump \"$SUPABASE_DB_URL\" -t public.books --no-owner > \"$TMP\"\nmv \"$TMP\" \"$OUT\"\necho \"$OUT\""
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        224,
        0
      ],
      "id": "99839938-27be-4319-a40f-1bce42b3be10",
      "name": "Dump books"
    },
    {
      "parameters": {
        "command": "find /backups -name 'books-*.sql' -type f -mtime +30 -delete\nfind /backups -name '.books-*.tmp' -type f -mtime +1 -delete"
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        448,
        0
      ],
      "id": "f04980ba-dbc0-4538-be92-304ce22f8bb0",
      "name": "Rotate old dumps"
    }
  ],
  "pinData": {},
  "connections": {
